{
  "name": "anzr-maps-socket-server",
  "version": "1.0.0",
  "description": "Socket.io server for ANZR Maps Let Loose collaborative rooms",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node -e \"console.log('No tests specified yet')\"",
    "lint": "node -e \"console.log('No linting configured yet')\"",
    "health-check": "node -e \"require('http').get('http://localhost:3001/health', (res) => { console.log('Health check:', res.statusCode === 200 ? 'OK' : 'FAIL'); process.exit(res.statusCode === 200 ? 0 : 1) })\""
  },
  "dependencies": {
    "socket.io": "^4.8.0",
    "express": "^4.18.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "keywords": [
    "socket.io",
    "realtime",
    "collaboration",
    "maps",
    "hell-let-loose"
  ],
  "author": "ANZR",
  "license": "MIT"
}
